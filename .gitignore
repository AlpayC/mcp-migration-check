node_modules/
dist/
.next/
.open-next/
out/
*.log
.env
.env.local
.dev.vars
.DS_Store
coverage/
*.tsbuildinfo
next-env.d.ts

# Social/marketing drafts. Working notes, not project artifacts — and a public
# repository is the wrong place for copy about the public repository.
drafts/

# Cloudflare
.wrangler/
cloudflare-env.d.ts

# Skill eval runs. The fixtures and evals.json are checked in as test material;
# the per-iteration outputs and the generated viewer are not.
skill/mcp-migration-workspace/iteration-*/
skill/mcp-migration-workspace/not-run/
skill/mcp-migration-workspace/eval-review.html

# Ecosystem report runs. The Markdown is the publishable artifact and is meant
# to be committed when a snapshot is worth keeping; the JSON alongside it names
# every server probed, which is a deliberately different thing to publish.
reports/*.json
# …except the aggregate summary. It names no server, and every surface that
# quotes a figure is generated from it — including in CI, which has no access
# to the full run above.
!reports/summary.json
# Probe checkpoints: a live run's scratch file, not a publication.
reports/.ecosystem-*.progress.jsonl
# The GitHub date cache backing the maintenance split.
reports/.repo-dates.json
