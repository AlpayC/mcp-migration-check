{
  "name": "mcp-migration-check",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic readiness checker for the MCP 2026-07-28 specification break",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "web"
  ],
  "scripts": {
    "build:skill": "node scripts/build-skill.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "build:bundles": "npm run build:skill && npm run build:cli",
    "build:ecosystem-snapshot": "node scripts/build-ecosystem-snapshot.mjs",
    "build:ecosystem-snapshot:extract": "node scripts/build-ecosystem-snapshot.mjs --extract",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "test": "node --import tsx --test \"packages/core/test/*.test.ts\"",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/core/tsconfig.test.json",
    "pack:skill": "node scripts/build-skill.mjs && node scripts/pack-skill.mjs",
    "report:ecosystem": "node --import tsx scripts/ecosystem-report.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
